# Vite inlines this at build time, so a production build has to be made with the deployed API's
# origin already set - there is no runtime configuration to fall back on.
#
# Vite loads .env.production only for `vite build`, and it takes priority over .env, so the
# localhost value in .env stays in effect for `vite dev` without leaking into a release build.
VITE_API_BASE_URL=https://api.mesaplumeria.org
